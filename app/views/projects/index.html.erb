<p style="color: green"><%= notice %></p>

<h1>Projects</h1>
<% if current_user %>
  <% if current_user.user_type == "manager" %>
    <%= link_to "Add New Project", new_project_path, class:'btn btn-primary text-white mx-2 my-2' %>
  <% end %>
<% end %>
<div id="projects" class="mx-4">
  <% @projects.each do |project| %>
    <%= render project %>
    <p>
      <%= link_to "Show this project", project, class:'btn btn-primary text-white mx-2 my-2' %>
    </p>
  <% end %>
</div>


