<br>
<div class="container">
  <div class="row">
     <% @projects.each do |project| %>
    <div class="col-md-2"></div>

      <div class="col-md-8 pb-3">
      <div class="card">
        <div class="card-header">
          Projects # <%= project.id%>
        </div>
        <div class="card-body">
          <h5 class="card-title"> <%= project.title%> </h5>

          <a href="#" class="btn btn-primary">Go somewhere</a>
        </div>
      </div>
    </div>
    <div class="col-md-2"></div>
    <% end %>
  </div>
</div>






