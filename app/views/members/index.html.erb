
<br>

<br><br>
<div class="container">
  <div class="row">
    <%= @users.each do |user| %>
      <div class="col-md-4 mb-4">
        <div class="card" style="width: 18rem;">
          <div class="card-body">
            <h5 class="card-title"><%= user.name %></h5>
            <h5 class="card-title"><%= user.email %></h5>
            <h5 class="card-title"><%= user.user_type %></h5>
            <%= link_to 'Add User to project', "/project/#{@project.id}/user/#{user.id}", class:'btn btn-primary' %>
          </div>
      </div>
    </div>

    <%end%>

  </div>
  <br><br>
</div>
